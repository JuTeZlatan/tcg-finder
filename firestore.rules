rules_version = '2';
// Règles de la base Firestore (à coller dans la console Firebase → Firestore Database → Règles) :
// chaque compte ne peut lire et écrire que ses propres données, sous users/{son identifiant}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
