# Adresse des données publiées chaque jour par la collecte (.github/workflows/data.yml → GitHub Pages).
# L'appli y lit les catalogues, prix et prochaines sorties du jour, et garde une copie pour le hors ligne ;
# sans réseau ni copie, elle utilise les données intégrées à la compilation (npm run data:bundle).
# Test local : EXPO_PUBLIC_DATA_URL=http://192.168.1.69:8080 avec `npm run data:serve`.
EXPO_PUBLIC_DATA_URL=https://jutezlatan.github.io/tcg-finder
