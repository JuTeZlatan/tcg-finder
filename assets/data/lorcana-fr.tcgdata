layer.com/product/722201"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/722201"}]},{"id":"3515","name":"Raiponce - Sauvée de l'ombre","number":"2","subtitle":"Spécial","image":"https://api.lorcana.ravensburger.com/images/fr/quest3/2_d0e75a535102f4380a057a7ad70326fafd3cf4bc.jpg","thumb":"https://api.lorcana.ravensburger.com/images/fr/quest3/2_fe344169ff2c08eb6b4275e9cb9eb0a9c623b218.jpg","details":[["set","Quête des Illumineurs: Équipe Miel à la rescousse"],["number","2 · Q3"],["rarity","Spécial"],["type","Personnage"],["cost",4],["inkwell","✗"],["strength",4],["willpower",4],["lore",2],["subTypes","Storyborn • Héros • Princesse"],["illustrator","Maria Dresden"]],"texts":[{"titleKey":"effect","body":"DÉFENSE DE FER Durant le tour de la Plante, ce personnage\ngagne Résistance +1. (Les dommages infligés à ce personnage\nsont réduits de 1.)\nCHBONGGG ! Une fois durant le tour des Illumineurs, un\nIllumineur peut payer 2 éclats de Lore pour choisir un\npersonnage Pousse et lui infliger 1 dommage. Ce dommage\nn'est pas réduit par Résistance."}],"prices":[{"source":"TCGplayer","items":[{"label":"market","variant":"normal","value":1.81,"currency":"USD"},{"label":"low","variant":"normal","value":1.38,"currency":"USD"}],"ref":{"value":1.81,"currency":"USD"},"url":"https://www.tcgplayer.com/product/722203"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/722203"}]},{"id":"3516","name":"Gardien de la Chambre - Protecteur de la Plante","number":"3","subtitle":"Spécial","image":"https://api.lorcana.ravensburger.com/images/fr/quest3/3_26795ad0a6da5ea3edcc9092932f372850902469.jpg","thumb":"https://api.lorcana.ravensburger.com/images/fr/quest3/3_55a0c45286ba79de7b26ddaec43aeda443ca1a2a.jpg","details":[["set","Quête des Illumineurs: Équipe Miel à la rescousse"],["number","3 · Q3"],["rarity","Spécial"],["type","Personnage"],["cost",5],["inkwell","✗"],["strength",5],["willpower",20],["lore",1],["subTypes","Boss • Pousse"],["illustrator","Rubin Chung / Leonardo Giammichele"]],"texts":[{"titleKey":"effect","body":"Hors d'atteinte\nCROISSANCE MALVEILLANTE Lorsque la Plante joue ce personnage,\ncréez une Liane pour chaque Illumineur et avancez le marqueur de\npioche de la Plante de 1.\nTRIOMPHE Lorsque ce personnage est banni, les Illumineurs\nremportent le scénario et ouvrent le paquet récompense À la\nrecherche de Porcinet !"}],"prices":[{"source":"TCGplayer","items":[{"label":"low","variant":"normal","value":3.49,"currency":"USD"}],"ref":null,"url":"https://www.tcgplayer.com/product/722204"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/722204"}]},{"id":"3517","name":"Sulli - Sauvé du jardin","number":"4","subtitle":"Spécial","image":"https://api.lorcana.ravensburger.com/images/fr/quest3/4_c55bbf5b4ab6c4df0f3488d19ed824af1b25d889.jpg","thumb":"https://api.lorcana.ravensburger.com/images/fr/quest3/4_bedd45171bb316566ec0dad5c6fc56785d71d6be.jpg","details":[["set","Quête des Illumineurs: Équipe Miel à la rescousse"],["number","4 · Q3"],["rarity","Spécial"],["type","Personnage"],["cost",2],["inkwell","✗"],["strength",4],["willpower",4],["lore",0],["subTypes","Storyborn • Héros • Monstre"],["illustrator","Chemène de Heus / Denny Minonne"]],"texts":[{"titleKey":"effect","body":"Combattant (Ce personnage ne peut pas être envoyé\nà l'aventure et doit défier à chaque tour s'il le peut.)\nRETOURNES-Y Chaque fois que ce personnage\nen bannit un autre via un défi, un Illumineur peut\npayer 1 éclat de Lore pour le redresser."}],"prices":[{"source":"TCGplayer","items":[{"label":"market","variant":"normal","value":1.64,"currency":"USD"},{"label":"low","variant":"normal","value":1.48,"currency":"USD"}],"ref":{"value":1.64,"currency":"USD"},"url":"https://www.tcgplayer.com/product/722207"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/722207"}]},{"id":"3518","name":"Maléfique - Sauvée de l'escalier","number":"5","subtitle":"Spécial","image":"https://api.lorcana.r