."}],"prices":[{"source":"Cardmarket","items":[{"label":"trend","value":0.08,"currency":"EUR"},{"label":"avg","value":0.07,"currency":"EUR"},{"label":"low","value":0.02,"currency":"EUR"},{"label":"avg7","value":0.07,"currency":"EUR"},{"label":"avg30","value":0.06,"currency":"EUR"},{"label":"trend","variant":"foil","value":0.9,"currency":"EUR"},{"label":"avg","variant":"foil","value":0.5,"currency":"EUR"},{"label":"low","variant":"foil","value":0.8,"currency":"EUR"}],"ref":{"value":0.07,"currency":"EUR"},"url":null},{"source":"TCGplayer","items":[{"label":"market","variant":"normal","value":0.31,"currency":"USD"},{"label":"low","variant":"normal","value":0.1,"currency":"USD"},{"label":"market","variant":"foil","value":6.99,"currency":"USD"},{"label":"low","variant":"foil","value":6.99,"currency":"USD"}],"ref":{"value":0.31,"currency":"USD"},"url":"https://www.tcgplayer.com/product/234408/dragon-ball-super-ccg-supreme-rivalry-son-gohan-ss2-son-gohan-pushed-to-the-brink"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/234408/dragon-ball-super-ccg-supreme-rivalry-son-gohan-ss2-son-gohan-pushed-to-the-brink"},{"label":"Cardmarket","url":"https://www.cardmarket.com/fr/DragonBallSuper/Products/Search?searchString=Son%20Gohan%20%2F%2F%20SS2%20Son%20Gohan%2C%20Pushed%20to%20the%20Brink"}]},{"id":"234409","name":"Boujack // Boujack, Subjugator Unbound","number":"BT13-032","subtitle":"Common","image":"https://tcgplayer-cdn.tcgplayer.com/product/234409_in_1000x1000.jpg","thumb":"https://tcgplayer-cdn.tcgplayer.com/product/234409_400w.jpg","details":[["set","Supreme Rivalry"],["number","BT13-032"],["rarity","Common"],["type","Leader"],["color","Blue"],["Special Trait","Boujack Brigade"],["power","10000/15000"],["Era","Boujack Saga"],["Character","Boujack"]],"texts":[{"titleKey":"effect","body":"[Permanent] Reduce the combo cost of mono-blue \"Boujack Brigade\" cards in your hand by 1.\r\n\n[Activate:Battle] [Once per turn] Use 1 mono-blue \"Boujack Brigade\" card in your energy in a combo. If you do, place the top card of your deck in your energy in rest mode.\r\n\n[Awaken] When your life is at 3 or less or you have a blue Unison Card with a specified cost of 4 in play : You may draw 2 cards, switch up to 1 of your energy to Active Mode, then flip this card over.\r\n\n\n\r\nBoujack, Subjugator Unbound\r\n\n[Permanent] Reduce the combo cost of mono-blue \"Boujack Brigade\" cards in your hand by 1.\r\n\n[Auto] [Once per turn] (B), choose 1 card in your hand and discard it, and you can only activate blue card skills from your hand and can't activate [Counter] skils from your hand for the turn : When your opponet attacks, switch up to 4 of your mono-blue energy to Active Mode.\r\n\n[Activate:Battle] [Once per turn] Use 1 mono-blue \"Boujack Brigade\" card in your energy in a combo. If you do, place the top card of your deck in your energy in Rest Mode."}],"prices":[{"source":"Cardmarket","items":[{"label":"trend","value":0.03,"currency":"EUR"},{"label":"avg","value":0.03,"currency":"EUR"},{"label":"low","value":0.02,"currency":"EUR"},{"label":"avg7","value":0.03,"currency":"EUR"},{"label":"avg30","value":0.03,"currency":"EUR"},{"label":"trend","variant":"foil","value":0.29,"currency":"EUR"},{"label":"low","variant":"foil","value":0.1,"currency":"EUR"}],"ref":{"value":0.03,"currency":"EUR"},"url":null},{"source":"TCGplayer","items":[{"label":"market","variant":"foil","value":0.51,"currency":"USD"},{"label":"low","variant":"foil","value":0.25,"currency":"USD"},{"label":"market","variant":"normal","value":0.05,"currency":"USD"},{"label":"low","variant":"normal","value":0.01,"currency":"USD"}],"ref":{"value":0.05,"currency":"USD"},"url":"https://www.tcgplayer.com/product/234409/dragon-ball-super-ccg-supreme-rivalry-boujack-boujack-subjugator-unbound"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/234409/dragon-ball-super-ccg-supreme-rivalry-boujack-boujack-subjugator-unbound"},{"label":"Cardmarket