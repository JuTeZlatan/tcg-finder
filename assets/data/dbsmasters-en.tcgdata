er-cdn.tcgplayer.com/product/542994_400w.jpg","details":[["set","Tournament Promotion Cards"],["number","BT22-138"],["rarity","Promo"],["type","Extra"],["color","Red"],["Energy(Color Cost)","0"],["BANDAI Disclaimer","This promotional card is marked “Not For Sale” by BANDAI, as the manufacturer prefers that Stores do not sell these cards."]],"texts":[{"titleKey":"effect","body":"[Ultimate] \n\r\n[Activate:Battle] Draw 1 card, choose up to 1 of your Leaders with its back face up, place up to 1 of your Z-Leaders from your Z-Deck with 20000 power or less and exactly the same color and character name as the chosen card on top of your Leader, then choose up to 1 of your Leaders, and it gets +20000 power for the battle. Additionally, if your Leader is a Z-Leader, your opponent's Battle Cards, and Unisons can't attack for the turn if they have 25000 power or more, then you remove your Z-Leader from the game at the end of your turn.\r\n\nA numbered series of 600 copies of this card was given out as part of the prizing for Dragon Ball Super Card Game Masters Championship 2024\r\nOnline/Offline Regionals Wave1. The number on the card you receive will vary from the number pictured in the listing unless otherwise shown in a Listing with Photo."}],"prices":[{"source":"TCGplayer","items":[{"label":"market","variant":"foil","value":1750,"currency":"USD"},{"label":"low","variant":"foil","value":2799.83,"currency":"USD"}],"ref":{"value":1750,"currency":"USD"},"url":"https://www.tcgplayer.com/product/542994/dragon-ball-super-ccg-tournament-promotion-cards-bursting-rage-serial-numbered"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/542994/dragon-ball-super-ccg-tournament-promotion-cards-bursting-rage-serial-numbered"},{"label":"Cardmarket","url":"https://www.cardmarket.com/fr/DragonBallSuper/Products/Search?searchString=Bursting%20Rage%20(Serial%20Numbered)"}]},{"id":"536084","name":"SS Gogeta, Fusion Reborn (2023 World Championship Stamp)","number":"BT22-140