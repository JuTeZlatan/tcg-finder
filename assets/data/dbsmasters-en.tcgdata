. +10000 power for the turn."}],"prices":[{"source":"Cardmarket","items":[{"label":"trend","value":0.09,"currency":"EUR"},{"label":"avg","value":0.06,"currency":"EUR"},{"label":"low","value":0.02,"currency":"EUR"},{"label":"avg7","value":0.11,"currency":"EUR"},{"label":"avg30","value":0.06,"currency":"EUR"},{"label":"trend","variant":"foil","value":0.43,"currency":"EUR"},{"label":"avg","variant":"foil","value":0.1,"currency":"EUR"},{"label":"low","variant":"foil","value":0.05,"currency":"EUR"}],"ref":{"value":0.08,"currency":"EUR"},"url":null},{"source":"TCGplayer","items":[{"label":"market","variant":"foil","value":0.49,"currency":"USD"},{"label":"low","variant":"foil","value":0.24,"currency":"USD"},{"label":"market","variant":"normal","value":0.15,"currency":"USD"},{"label":"low","variant":"normal","value":0.04,"currency":"USD"}],"ref":{"value":0.15,"currency":"USD"},"url":"https://www.tcgplayer.com/product/520864/dragon-ball-super-ccg-perfect-combination-trunks-and-mai-ss-trunks-and-mai-saviors-of-hope"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/520864/dragon-ball-super-ccg-perfect-combination-trunks-and-mai-ss-trunks-and-mai-saviors-of-hope"},{"label":"Cardmarket","url":"https://www.cardmarket.com/fr/DragonBallSuper/Products/Search?searchString=Trunks%20%26%20Mai%20%2F%2F%20SS%20Trunks%20%26%20Mai%2C%20Saviors%20of%20Hope"}]},{"id":"520732","name":"Zamasu & Goku Black // Zamasu & SS Rose Goku Black, Humanity's Destruction","number":"BT23-072","subtitle":"Uncommon","image":"https://tcgplayer-cdn.tcgplayer.com/product/520732_in_1000x1000.jpg","thumb":"https://tcgplayer-cdn.tcgplayer.com/product/520732_400w.jpg","details":[["set","Perfect Combination"],["number","BT23-072"],["rarity","Uncommon"],["type","Leader"],["color","Green"],["Special Trait","Saiyan/God"],["power","10000/15000"],["Era","Future Trunks Saga"],["Character","Zamasu/Goku Black"]],"texts":[{"titleKey":"effect","body":"Zamasu & Goku Black\r\n\n[Permanent] Your multicolo