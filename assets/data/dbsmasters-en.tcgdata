1000.jpg","thumb":"https://tcgplayer-cdn.tcgplayer.com/product/511857_400w.jpg","details":[["set","Critical Blow"],["number","BT22-051"],["rarity","Super Rare"],["type","Battle"],["color","Blue"],["Energy(Color Cost)","7(U)"],["Z-Energy Cost","0"],["Special Trait","God"],["power","20000"],["Combo Power","10000"],["Combo Energy","1"],["Era","Battle of Gods Saga"],["Character","Beerus"]],"texts":[{"titleKey":"effect","body":"[Unique] \n\r\n[Permanent] For every card in your Z-Energy, reduce the energy cost of this card in your hand by 3. \n\r\n[Auto] [Limit 1] If it's your turn: When this card attacks or is used in a combo, choose up to 1 of your opponent's Battle Cards and add it to its owner's hand. \n\r\n[Auto] [Once per turn] If your Leader is a blue \"Whis\" card and you have 3 or more energy: When this card attacks and KOs an opponent's Battle Card, switch this card to Active Mode, and this card gets +10000 power, [Double Strike], and [Dual Attack] for the turn."}],"prices":[{"source":"Cardmarket","items":[{"label":"trend","variant":"foil","value":0.27,"currency":"EUR"},{"label":"avg","variant":"foil","value":0.24,"currency":"EUR"},{"label":"low","variant":"foil","value":0.1,"currency":"EUR"}],"ref":{"value":0.26,"currency":"EUR"},"url":null},{"source":"TCGplayer","items":[{"label":"market","variant":"foil","value":0.29,"currency":"USD"},{"label":"low","variant":"foil","value":0.1,"currency":"USD"}],"ref":{"value":0.29,"currency":"USD"},"url":"https://www.tcgplayer.com/product/511857/dragon-ball-super-ccg-critical-blow-beerus-merciless-destruction"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/511857/dragon-ball-super-ccg-critical-blow-beerus-merciless-destruction"},{"label":"Cardmarket","url":"https://www.cardmarket.com/fr/DragonBallSuper/Products/Search?searchString=Beerus%2C%20Merciless%20Destruction"}]},{"id":"511858","name":"Whis, Perfect Support","number":"BT22-052","subtitle":"Common","image":"https://tcgplayer-cdn.tcgplayer.com/product/511858_in_1000x1000.jpg","thumb":"https://tcgplayer-cdn.tcgplayer.com/product/511858_400w.jpg","details":[["set","Critical Blow"],["number","BT22-052"],["rarity","Common"],["type","Battle"],["color","Blue"],["Energy(Color Cost)","4(U)"],["Z-Energy Cost","0"],["Special Trait","God"],["power","15000"],["Combo Power","5000"],["Combo Energy","0"],["Era","Battle of Gods Saga"],["Character","Whis"]],"texts":[{"titleKey":"effect","body":"[Auto] [Limit 1]U , if your Leader is a blue \"Whis\" card and you have 2 or more energy: When this card is used in a combo from your hand, play up to 1\"Beerus\" or \"Whis\" card—both blue and with an energy cost of 2 or less—from your hand at the end of the battle. \n\r\n[Activate:Main] [Limit 1] If your Leader is a blue \"Whis\" card and you remove this card in your Z-Energy from the game: Choose up to 1 of your blue \"Beerus\" cards and it gets +5000 power for the turn."}],"prices":[{"source":"Cardmarket","items":[{"label":"trend","value":0.02,"currency":"EUR"},{"label":"avg","value":0.05,"currency":"EUR"},{"label":"low","value":0.02,"currency":"EUR"},{"label":"avg7","value":0.02,"currency":"EUR"},{"label":"avg30","value":0.02,"currency":"EUR"},{"label":"trend","variant":"foil","value":0.15,"currency":"EUR"},{"label":"avg","variant":"foil","value":0.1,"currency":"EUR"},{"label":"low","variant":"foil","value":0.08,"currency":"EUR"}],"ref":{"value":0.02,"currency":"EUR"},"url":null},{"source":"TCGplayer","items":[{"label":"market","variant":"normal","value":0.04,"currency":"USD"},{"label":"low","variant":"normal","value":0.04,"currency":"USD"},{"label":"market","variant":"foil","value":0.06,"currency":"USD"},{"label":"low","variant":"foil","value":0.06,"currency":"USD"}],"ref":{"value":0.04,"currency":"USD"},"url":"https://www.tcgplayer.com/product/511858/dragon-ball-super-ccg-critical-blow-whis-perfect-support"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/511858/dragon-ball-super-ccg-critical-blow-whis-perfect-support"},{"label":"Cardmarket","url":"https://www.cardmarket.com/fr/DragonBallSuper/Products/Search?searchString=Whis%2C%20Perfect%20Support"}]},{"id":"511736","name":"Barrier Around Check-In Station","number":"BT22-053","subtitle":"Common","image":"https://tcgplayer-cdn.tcgplayer.com/product/511736_in_1000x1000.jpg","thumb":"https://tcgplayer-cdn.tcgplayer.com/product/511736_400w.jpg","details":[["set","Critical Blow"],["number","BT22-053"],["rarity","Common"],["type","Extra"],["color","Blue"],["Energy(Color Cost)","6(UUU)"]],"texts":[{"titleKey":"effect","body":"[Barrier] [Field] <br?\r\n[Permanent] You can't play black Battle Cards. \n\r\n[Activate:Main/Battle] U, if your Leader is \"Janemba, Silent Demon\" and you have a blue Z-Extra in your Battle Area : Play up to 1 blue \"Janemba\" card with an original energy cost of 6 from your hand."}],"prices":[{"source":"TCGplayer","items":[{"label":"low","variant":"normal","value":0.02,"currency":"USD"},{"label":"market","variant":"foil","value":0.26,"currency":"USD"},{"label":"low","variant":"foil","value":0.13,"currency":"USD"}],"ref":{"value":0.26,"currency":"USD"},"url":"https://www.tcgplayer.com/product/511736/dragon-ball-super-ccg-critical-blow-barrier-around-check-in-station"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/511736/dragon-ball-super-ccg-critical-blow-barrier-around-check-in-station"},{"label":"Cardmarket","url":"https://www.cardmarket.com/fr/DragonBallSuper/Products/Search?searchString=Barrier%20Around%20Check-In%20Station"}]},{"id":"508020","name":"Son Goten // SS Son Gohan & SS Son Goten, Brothers","number":"BT22-054","subtitle":"Uncommon","image":"https://tcgplayer-cdn.tcgplayer.com/product/508020_in_1000x1000.jpg","thumb":"https://tcgplayer-cdn.tcgplayer.com/product/508020_400w.jpg","details":[["set","Critical Blow"],["number","BT22-054"],["rarity","Uncommon"],["type","Leader"],["color","Green"],["Special Trait","Saiyan/Earthling"],["power","10000/15000"],["Era","Broly Saga"],["Character","Son Gohan : Adolescence/Son Goten"]],"texts":[{"titleKey":"effect","body":"Son Goten\r\n\n\r\n[Activate:Main] [Once per turn] Look at up to 5 cards from the top of your deck and add up to 1 green \"Son Gohan : Adolescence\" or \"Son Goten\" card to your hand, then shuffle your deck.\r\n\n\r\n[Awaken] When your life is at 4 or less or you have 2 or more energy and you have a [Family Kamehameha, Emotions Delivered] in your Battle Area : Draw 2 cards and add cards from your life to your hand until you have 6 life left.\r\n\n//\n\r\nSS Son Gohan & SS Son Goten, Brothers\r\n\n\r\n[Auto] [Once per turn] When you play a \"Son Gohan : Adolescence\" or \"Son Goten\" card—both green and with an energy cost of 6 or more—from your hand, draw 1 card.\r\n\n\r\n[Activate:Main] [Once per turn] Play up to 1 [Son Gohan, Close Call] or [Son Goten, Close Call] from your hand or Drop in Rest Mode.\r\n\n\r\n[Activate:Battle] [Once per turn] If you discard 1 card from your hand : During that turn, the next time you activate [Activate: Battle] on a \"Son Gohan : Adolescence\" or \"Son Goten\" card—both green and with an energy cost of 6—from your hand, reduce that skill's skill cost by G."}],"prices":[{"source":"Cardmarket","items":[{"label":"trend","value":0.06,"currency":"EUR"},{"label":"avg","value":0.02,"currency":"EUR"},{"label":"low","value":0.02,"currency":"EUR"},{"label":"avg7","value":0.03,"currency":"EUR"},{"label":"avg30","value":0.06,"currency":"EUR"},{"label":"trend","variant":"foil","value":0.91,"currency":"EUR"},{"label":"avg","variant":"foil","value":0.82,"currency":"EUR"},{"label":"low","variant":"foil","value":0.14,"currency":"EUR"}],"ref":{"value":0.05,"currency":"EUR"},"url":null},{"source":"TCGplayer","items":[{"label":"market","variant":"foil","value":0.61,"currency":"USD"},{"label":"low","variant":"foil","value":0.1,"currency":"USD"},{"label":"market","variant":"normal","value":0.09,"currency":"USD"},{"label":"low","variant":"normal",