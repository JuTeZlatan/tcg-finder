nd that card gets +5000 power for the turn."}],"prices":[{"source":"Cardmarket","items":[{"label":"trend","value":0.06,"currency":"EUR"},{"label":"avg","value":0.07,"currency":"EUR"},{"label":"low","value":0.02,"currency":"EUR"},{"label":"avg7","value":0.06,"currency":"EUR"},{"label":"avg30","value":0.05,"currency":"EUR"},{"label":"trend","variant":"foil","value":1.2,"currency":"EUR"},{"label":"avg","variant":"foil","value":0.45,"currency":"EUR"},{"label":"low","variant":"foil","value":0.19,"currency":"EUR"}],"ref":{"value":0.06,"currency":"EUR"},"url":null},{"source":"TCGplayer","items":[{"label":"market","variant":"foil","value":0.17,"currency":"USD"},{"label":"low","variant":"foil","value":0.18,"currency":"USD"},{"label":"market","variant":"normal","value":0.11,"currency":"USD"},{"label":"low","variant":"normal","value":0.05,"currency":"USD"}],"ref":{"value":0.11,"currency":"USD"},"url":"https://www.tcgplayer.com/product/495572/dragon-ball-super-ccg-wild-resurgence-baby-baby-awakening-with-a-grudge"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/495572/dragon-ball-super-ccg-wild-resurgence-baby-baby-awakening-with-a-grudge"},{"label":"Cardmarket","url":"https://www.cardmarket.com/fr/DragonBallSuper/Products/Search?searchString=Baby%20%2F%2F%20Baby%2C%20Awakening%20With%20a%20Grudge"}]},{"id":"496117","name":"Uub, Fusion of Two Spirits","number":"BT21-036","subtitle":"Uncommon","image":"https://tcgplayer-cdn.tcgplayer.com/product/496117_in_1000x1000.jpg","thumb":"https://tcgplayer-cdn.tcgplayer.com/product/496117_400w.jpg","details":[["set","Wild Resurgence"],["number","BT21-036"],["rarity","Uncommon"],["type","Z-Leader"],["color","Blue"],["Z-Energy Cost","3"],["Special Trait","Earthling"],["power","20000"],["Era","Baby Saga"],["Character","Uub"]],"texts":[{"titleKey":"effect","body":"[Z-Awaken] B, you have 3 or less life and you place 1 blue \"Mr. Buu\" from your Drop under this card : Blue \"Uub\".\r\n\n[Auto] [Once per turn] When this 