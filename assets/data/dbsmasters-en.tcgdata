tle"],["color","Green, Yellow"],["Energy(Color Cost)","8(GY)"],["Special Trait","Saiyan"],["power","40000"],["Combo Power","10000"],["Combo Energy","0"],["Era","Special"],["Character","Raditz/Broly/Goku Black/Turles"]],"texts":[{"titleKey":"effect","body":"[Ultimate] [Energy-Exhaust]\r\n\n[Permanent] If this card is removed from your Battle Area, remove it from the game instead.\r\n\n[Permanent] If your opponent has 2 or more energy and your Leader Card is green, yellow, or shares a character name with this card, this card gains [Dual Attack] and [Blocker].\r\n\n[Auto] 2 : At the end of a battle in which this card was used in a combo from your hand, your opponent may choose 4 of their cards and switch them to Rest Mode. If they do, remove this card in your Drop Area from the game. If they don't, play this card from your Drop Area, and your opponent chooses 2 cards in their hand and discards them."}],"prices":[{"source":"Cardmarket","items":[{"label":"trend","variant":"foil","value":49.9,"currency":"EUR"},{"label":"avg","variant":"foil","value":51.28,"currency":"EUR"},{"label":"low","variant":"foil","value":40,"currency":"EUR"}],"ref":{"value":50.52,"currency":"EUR"},"url":null},{"source":"TCGplayer","items":[{"label":"market","variant":"foil","value":115.59,"currency":"USD"},{"label":"low","variant":"foil","value":108.29,"currency":"USD"}],"ref":{"value":115.59,"currency":"USD"},"url":"https://www.tcgplayer.com/product/252896/dragon-ball-super-ccg-saiyan-showdown-the-wicked-saiyans"}],"links":[{"label":"TCGplayer","url":"https://www.tcgplayer.com/product/252896/dragon-ball-super-ccg-saiyan-showdown-the-wicked-saiyans"},{"label":"Cardmarket","url":"https://www.cardmarket.com/fr/DragonBallSuper/Products/Search?searchString=The%20Wicked%20Saiyans"}]},{"id":"252898","name":"The Radiant Saiyans","number":"BT15-154","subtitle":"Secret Rare","image":"https://tcgplayer-cdn.tcgplayer.com/product/252898_in_1000x1000.jpg","thumb":"https://tcgplayer-cdn.tcgplayer.com/product/25